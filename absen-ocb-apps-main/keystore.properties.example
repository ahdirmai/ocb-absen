# Salin jadi keystore.properties (JANGAN di-commit) lalu isi kredensial asli.
# storeFile: path relatif terhadap root project absen-ocb-apps-main, atau absolut.
#
# Keystore release yang benar (harus cocok APK yang sudah beredar):
#   Owner    : CN=ocb, OU=ocb, O=ocb
#   SHA-256  : 40:B6:9B:30:9F:D5:31:43:F0:C0:60:00:EB:F8:9A:C5:28:29:78:A8:DD:C5:68:44:0F:C7:3F:6A:A2:AB:DE:4E
#
# Verifikasi sebelum build:
#   keytool -list -v -keystore <path> -alias <alias> | grep -E "Owner|SHA256"

storeFile=ocb-release.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
